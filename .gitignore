# Environments
.venv/
__pycache__/
*.pyc

# Raw tier: insurance, not archive — 14-day rolling retention, never committed.
data/raw/*.json.gz

# Historical backfill: raw downloads are re-fetchable cache, not committed.
# The normalized data/historical/{season}.parquet *is* committed — §8 requires
# every reported metric to regenerate from a single command against committed
# data, and the backtest harness must not depend on vaastav's repo staying up.
data/historical/raw/

# Generated reports — regenerate with the commands in README.md.
backtest/report.json
analytics/report.json
papertrade/report.json

# Local overrides
.env

# Generated knowledge graph (/graphify) — AST cache, graph.json, graph.html.
# Regenerates from the source it indexes; 3.4MB of churn, not an input to anything.
graphify-out/

# §5.3.4: panel.parquet and timeseries.parquet are build artifacts, not
# committed — size and churn. columns.json and the other seven JSON files
# ARE committed, so a fresh clone renders Correlation Lab, Comparison,
# Explorer, Model Board and Scorecard with no pipeline run. The routes
# that need these two show an explanatory empty state when they're absent.
data/web/v1/*.parquet
